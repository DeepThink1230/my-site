---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MomentItem from '../components/MomentItem.astro';
import { SITE } from '../config';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const moments = (await getCollection('moments')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const recentPosts = posts.slice(0, 3);
const recentMoments = moments.slice(0, 4);
---

<Base>
  <section class="card taped hero">
    <h1 class="hello"><span class="wave">👋</span> 你好呀，欢迎来到{SITE.name}</h1>
    <p class="motto">{SITE.motto}</p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>💭 最新动态</h2>
      <a class="more" href="/moments/">查看全部 →</a>
    </div>
    <div class="timeline">
      {recentMoments.map((m) => <MomentItem moment={m} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>📝 最近随笔</h2>
      <a class="more" href="/essays/">查看全部 →</a>
    </div>
    <div class="post-list">
      {recentPosts.map((p) => (
        <a class="card taped hoverable post-card" href={`/essays/${p.id}/`} style="display:block">
          <h3>{p.data.title}</h3>
          <div class="meta">
            <span>📅 {p.data.date.toISOString().slice(0, 10)}</span>
            {p.data.tags.map((t) => <span class="tag">#{t}</span>)}
          </div>
          {p.data.summary && <p class="summary">{p.data.summary}</p>}
        </a>
      ))}
    </div>
  </section>
</Base>
