---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import { formatShort } from '../../utils';

const albums = (await getCollection('albums')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 扫描所有相册文件夹里的图片
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/albums/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

function coverOf(folder: string): ImageMetadata | undefined {
  const first = Object.keys(files)
    .filter((path) => path.startsWith(`/src/assets/albums/${folder}/`))
    .sort()[0];
  return first ? files[first].default : undefined;
}

function countOf(folder: string): number {
  return Object.keys(files).filter((path) => path.startsWith(`/src/assets/albums/${folder}/`)).length;
}
---

<Base title="相册" description="用照片保存的生活瞬间" wide>
  <div class="album-grid" style="margin-top: 18px;">
    {albums.map((album) => {
      const cover = coverOf(album.data.folder);
      const count = countOf(album.data.folder);
      return (
        <a class="card taped hoverable album-card" href={`/gallery/${album.id}/`}>
          <div class="cover">
            {cover ? (
              <Image src={cover} width={640} alt={album.data.title} loading="lazy" />
            ) : (
              <div class="empty-tip">📷 还没有照片</div>
            )}
          </div>
          <div class="album-info">
            <h3>{album.data.title}</h3>
            <div class="album-meta">
              📅 {formatShort(album.data.date)} · {count} 张
            </div>
            {album.data.summary && <div class="album-meta" style="margin-top:4px">{album.data.summary}</div>}
          </div>
        </a>
      );
    })}
  </div>
  {albums.length === 0 && <p class="empty-tip">还没有相册 📷</p>}
</Base>
