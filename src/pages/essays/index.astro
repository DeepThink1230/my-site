---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatShort, groupByMonth } from '../../utils';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const grouped = groupByMonth(posts, (p) => p.data.date);
---

<Base title="随笔" description="生活随笔与日记">
  {grouped.map(([month, items]) => (
    <section class="section">
      <h2 class="month-label">{month}</h2>
      <div class="post-list">
        {items.map((p) => (
          <a class="card taped hoverable post-card" href={`/essays/${p.id}/`} style="display:block">
            <h3>{p.data.title}</h3>
            <div class="meta">
              <span>📅 {formatShort(p.data.date)}</span>
              {p.data.tags.map((t) => <span class="tag">#{t}</span>)}
            </div>
            {p.data.summary && <p class="summary">{p.data.summary}</p>}
          </a>
        ))}
      </div>
    </section>
  ))}
  {posts.length === 0 && <p class="empty-tip">还没有写过随笔 🍃</p>}
</Base>
