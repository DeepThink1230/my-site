---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatShort } from '../utils';

interface Props {
  moment: CollectionEntry<'moments'>;
}

const { moment } = Astro.props;
const { Content } = await render(moment);

// 把 src/assets/moments/ 里的图片按文件名建立索引，供 frontmatter 里的 images 引用
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/moments/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const byName = new Map(Object.entries(files).map(([path, mod]) => [path.split('/').pop()!, mod.default]));

const pics = moment.data.images
  .map((name) => byName.get(name))
  .filter((meta): meta is ImageMetadata => Boolean(meta));
---

<div class="moment">
  <div class="moment-date">
    {formatShort(moment.data.date)}
    {moment.data.mood && <span class="moment-mood">{moment.data.mood}</span>}
  </div>
  <div class="card">
    <div class="prose moment-text"><Content /></div>
    {pics.length > 0 && (
      <div class="pics">
        {pics.map((pic) => (
          <Image
            src={pic}
            width={220}
            class="zoomable"
            alt="动态配图"
            loading="lazy"
          />
        ))}
      </div>
    )}
  </div>
</div>
