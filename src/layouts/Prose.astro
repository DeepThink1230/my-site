---
import Base from './Base.astro';

interface Props {
  title?: string;
  frontmatter?: { title?: string };
}

// Markdown 页面通过 frontmatter 传标题，.astro 页面直接传 props
const { title, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title;
---

<Base title={pageTitle}>
  <article class="card taped prose" style="margin-top: 18px; padding: 34px 34px;">
    <slot />
  </article>
</Base>
